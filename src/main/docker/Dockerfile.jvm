# JVM image for inventory-server — the bus worker host joins the Vert.x
# cluster, and the vertx-infinispan cluster manager is the one component not
# yet proven under GraalVM native, so bus members run on the JVM.
# Build the fast-jar first:  mvn -pl inventory-server -am package -DskipTests
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.21
ENV LANGUAGE='en_US:en'
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"
USER 185
ENTRYPOINT [ "java", "-Dquarkus.http.host=0.0.0.0", "-jar", "/deployments/quarkus-run.jar" ]
